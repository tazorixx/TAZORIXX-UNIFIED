# SERVER ONLY. Copy to .env on the VM; never commit actual passwords or API keys.
# Generate distinct long random secrets with: openssl rand -hex 32
GATEWAY_DOMAIN=wa.yourdomain.example
STUDIO_DOMAIN=studio.yourdomain.example
MYSQL_DATABASE=wa_gateway
MYSQL_USER=wa_gateway_app
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_ALPHANUMERIC_PASSWORD
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Keep ENCRYPTION_KEY unchanged forever after connecting WhatsApp; 64 hex characters
ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
STUDIO_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
STUDIO_ADMIN_PASSWORD=REPLACE_WITH_16_PLUS_RANDOM_CHARACTERS
GATEWAY_BASIC_USER=admin
# Generate with: docker run --rm -it caddy:2 caddy hash-password
GATEWAY_BASIC_HASH=REPLACE_WITH_CADDY_HASH
# Only after creating a Gateway user and API key in its admin UI:
GATEWAY_API_KEY=
GATEWAY_SESSION_ID=
# IMPORTANT: Stay false during first deployment and desktop->cloud data migration
ENABLE_SENDING=false
